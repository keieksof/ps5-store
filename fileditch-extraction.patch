+extern "C" int orbit_unrar_inspect(const char *archive, const char *password, int *multi_volume,
+                                   uint64_t *unpacked_size, char *error, size_t cap) {
+    if (error && cap)
+        error[0] = '\0';
+    ShimCtx ctx = {password, nullptr, nullptr, false};
+    HANDLE h = open_archive(archive, password, &ctx, error, cap);
+    if (!h)
+        return ORBIT_UNRAR_FAILED;
+    int volume = 0;
+    uint64_t total = 0;
+    int result = ORBIT_UNRAR_OK;
+    for (;;) {
+        RARHeaderDataEx hd;
+        std::memset(&hd, 0, sizeof hd);
+        int rc = RARReadHeaderEx(h, &hd);
+        if (rc == ERAR_END_ARCHIVE)
+            break;
+        if (rc != ERAR_SUCCESS) {
+            map_rc(rc, error, cap);
+            result = ORBIT_UNRAR_FAILED;
+            break;
+        }
