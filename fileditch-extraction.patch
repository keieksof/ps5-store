+"""Append dlpsgame fileditch folder dumps to the embedded catalogue.
+
+Reads a discovery crawl (fd-crawl-results.json), keeps posts whose single live
+file is one plain [DLPSGAME.COM]-<title ID>.rar, proves every kept file against
+the fileditch status API, fetches post artwork for games the catalogue does not
+know yet, and appends the matching releases plus games to catalog/releases.json
+and catalog/games.json. Existing ids are kept, so the crawl can be re-run.
+
+Run with .venv/bin/python tools/fd_catalog.py <fd-crawl-results.json> [--commit]
+The default is a dry run; --commit writes the catalogue inputs after a clean pass.
+"""
+import json
+import re
+import struct
+import sys
+import time
+import urllib.parse
+import urllib.request
+from pathlib import Path
+
+import catalog as cat
+
+DELAY = 1.2
+LIMIT_PAGE = 6_000_000
+LIMIT_IMAGE = 12_000_000
+UA = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) Orbit-Catalogue/1'}
+PLAIN_NAME = re.compile(r'\[DLPSGAME\.COM\]-.*\.rar', re.I)
+TITLE_IN_NAME = re.compile(r'PPSA\d+')
+VERSION_IN_NAME = re.compile(r'(\d{2}\.\d{3}\.\d{3})')
+
+
+def fetch(url, limit):
+    with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=45) as response:
+        if response.status != 200:
+            raise ValueError(f'HTTP {response.status} for {url}')
+        body = response.read(limit)
+        if len(body) >= limit:
+            raise ValueError(f'Oversized response for {url}')
+        return body
+
+
+def og_value(page, name):
+    for pattern in (rf'<meta[^>]+property=["\']{name}["\'][^>]+content=["\']([^"\']+)["\']',
+                    rf'<meta[^>]+content=["\']([^"\']+)["\'][^>]+property=["\']{name}["\']'):
+        match = re.search(pattern, page, re.I)
+        if match:
+            return urllib.parse.unquote(match.group(1)).replace('&amp;', '&')
+    return None
+
+
+def image_size(data):
+    """Pixel dimensions of the codecs the storefront serves: PNG/JPEG/GIF/WebP."""
+    if data[:8] == b'\x89PNG\r\n\x1a\n' and len(data) >= 24:
+        return struct.unpack('>II', data[16:24])
+    if data[:2] == b'\xff\xd8':
+        i = 2
+        while i + 9 < len(data):
+            if data[i] != 0xFF:
+                i += 1
+                continue
+            marker = data[i + 1]
+            if marker in (0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE,
+                          0xCF):
+                height, width = struct.unpack('>HH', data[i + 5:i + 9])
+                return width, height
+            if marker in (0xD8, 0x01) or 0xD0 <= marker <= 0xD7:
+                i += 2
+            else:
+                i += 2 + struct.unpack('>H', data[i + 2:i + 4])[0]
+        raise ValueError('JPEG without a frame header')
+    if data[:6] in (b'GIF87a', b'GIF89a'):
+        return struct.unpack('<HH', data[6:10])
+    if data[:4] == b'RIFF' and data[8:12] == b'WEBP':
+        chunk = data[12:16]
+        if chunk == b'VP8X':
+            return (int.from_bytes(data[24:27], 'little') + 1,
+                    int.from_bytes(data[27:30], 'little') + 1)
+        if chunk == b'VP8 ':
+            width, height = struct.unpack('<HH', data[26:30])
+            return width & 0x3FFF, height & 0x3FFF
+        if chunk == b'VP8L':
+            bits = int.from_bytes(data[21:25], 'little')
+            return (bits & 0x3FFF) + 1, ((bits >> 14) & 0x3FFF) + 1
+    raise ValueError('Not a supported image')
+
+
+def candidates(crawl):
+    """Posts whose only live file is one plain single-volume dlpsgame archive."""
+    kept, skipped = [], {'multiple files': 0, 'not one plain .rar': 0, 'title id taken': 0}
+    seen = set()
+    for post in crawl['posts']:
+        alive = [v for v in post.get('valid', []) if v.get('alive')]
+        if len(alive) != 1:
+            skipped['multiple files'] += 1
+            continue
+        name = urllib.parse.unquote(alive[0]['file']).rsplit('/', 1)[-1]
+        title_ids = TITLE_IN_NAME.findall(name)
+        if (PLAIN_NAME.fullmatch(name) is None or len(title_ids) != 1
+                or re.fullmatch(r'PPSA\d{5}', title_ids[0]) is None
+                or re.search(r'\.part\d+\.rar$', name, re.I)):
+            skipped['not one plain .rar'] += 1
+            continue
+        tid = title_ids[0]
+        if post.get('titleId') and post['titleId'] != tid:
+            raise ValueError(f"{post['slug']}: post title id {post['titleId']} != file {tid}")
+        if tid in seen:
+            skipped['title id taken'] += 1
+            continue
+        seen.add(tid)
+        kept.append((post, alive[0], tid, name))
+    return kept, skipped
+
+
+def main():
+    arguments = [a for a in sys.argv[1:] if a != '--commit']
+    if len(arguments) != 1:
+        raise SystemExit(__doc__)
+    commit = '--commit' in sys.argv
+    crawl = json.loads(Path(arguments[0]).read_text(encoding='utf-8'))
+    games, releases = cat.read('games.json'), cat.read('releases.json')
+    release_ids = {r['id'] for r in releases}
+    game_ids = {g['id'] for g in games}
+    by_title = {}
+    for r in releases:
+        by_title.setdefault(r['titleId'], r['gameId'])
+
+    kept, skipped = candidates(crawl)
+    new_releases, new_games, errors, listed = [], [], [], []
+    for post, valid, tid, name in kept:
+        release_id = tid.lower() + '-folder'
+        if release_id in release_ids:
