+#include "extract_unrar.h"
+
+#include <cstdio>
+#include <cstring>
+
+#ifndef _UNIX
+#define _UNIX /* dll.hpp's platform block; unrar's own raros.hpp provides it normally. */
+#endif
+#include "unrar/dll.hpp"
+
+/* Thin C shim over UnRAR's DLL API. Kept in C++ so dll.hpp's linkage and
+ * unrar's internals never reach the C backend. Passwords are supplied through
+ * the open-time callback because fileditch archives encrypt their headers:
+ * RARSetPassword alone is too late (the header decrypt happens during
+ * RAROpenArchiveEx). Returning -1 from UCM_PROCESSDATA raises RARX_USERBREAK,
+ * which dll.cpp catches and maps to an ERAR_* code, so cancellation never
+ * escapes this boundary as a C++ exception. */
+
+namespace {
+
+struct ShimCtx {
+    const char *password;
+    orbit_unrar_cancel_fn cancel;
+    void *cancel_ctx;
+    bool aborted;
+};
+
+void set_error(char *error, size_t cap, const char *text) {
+    if (error && cap)
+        std::snprintf(error, cap, "%s", text);
+}
+
+void map_rc(int rc, char *error, size_t cap) {
+    switch (rc) {
+        case ERAR_MISSING_PASSWORD:
+            set_error(error, cap, "The archive password could not be supplied.");
+            break;
+        case ERAR_BAD_PASSWORD:
+            set_error(error, cap, "The archive password was rejected.");
+            break;
+        case ERAR_BAD_DATA:
+            set_error(error, cap, "The archive is damaged or its password is wrong.");
+            break;
+        case ERAR_BAD_ARCHIVE:
+        case ERAR_UNKNOWN_FORMAT:
+            set_error(error, cap, "The downloaded file is not a supported RAR archive.");
+            break;
+        case ERAR_EOPEN:
+        case ERAR_EREAD:
+            set_error(error, cap, "The archive could not be read from the drive.");
+            break;
+        case ERAR_ECREATE:
+            set_error(error, cap,
+                      "A file could not be written. The drive may be full or read-only.");
+            break;
+        case ERAR_NO_MEMORY:
+        case ERAR_LARGE_DICT:
+            set_error(error, cap, "The archive needs more memory than this console has available.");
+            break;
+        default:
+            set_error(error, cap, "Archive extraction failed.");
+            break;
+    }
+}
+
+int shim_callback(UINT msg, LPARAM user_data, LPARAM p1, LPARAM p2) {
+    ShimCtx *ctx = reinterpret_cast<ShimCtx *>(static_cast<uintptr_t>(user_data));
+    switch (msg) {
+        case UCM_NEEDPASSWORD: {
+            char *buf = reinterpret_cast<char *>(p1);
+            size_t cap = static_cast<size_t>(p2);
+            if (!ctx->password || !buf || cap == 0)
+                return -1;
+            size_t n = std::strlen(ctx->password);
+            if (n + 1 > cap)
+                return -1;
+            std::memcpy(buf, ctx->password, n + 1);
+            return static_cast<int>(n);
+        }
+        case UCM_NEEDPASSWORDW: {
+            wchar_t *buf = reinterpret_cast<wchar_t *>(p1);
+            size_t cap = static_cast<size_t>(p2);
+            if (!ctx->password || !buf || cap == 0)
+                return -1;
+            size_t n = std::strlen(ctx->password);
+            if (n + 1 > cap)
+                return -1;
+            for (size_t i = 0; i < n; i++)
+                buf[i] = static_cast<wchar_t>(static_cast<unsigned char>(ctx->password[i]));
+            buf[n] = L'\0';
+            return static_cast<int>(n);
+        }
+        case UCM_PROCESSDATA:
+            if (ctx->cancel && ctx->cancel(ctx->cancel_ctx)) {
+                ctx->aborted = true;
+                return -1;
+            }
+            return 0;
+        case UCM_CHANGEVOLUME:
+        case UCM_CHANGEVOLUMEW:
+            /* Inspect already rejects multi-volume sets; never prompt for one. */
+            return -1;
+        case UCM_LARGEDICT:
+        default:
+            return 0;
+    }
+}
+
+/* ASCII paths are the console norm; decode UTF-8 properly so drive labels with
+ * non-ASCII names still land correctly. Invalid bytes become U+FFFD. */
+size_t utf8_to_wide(const char *src, wchar_t *dst, size_t cap) {
+    size_t out = 0;
+    const unsigned char *p = reinterpret_cast<const unsigned char *>(src);
+    while (*p) {
+        uint32_t cp = 0xFFFD;
+        int extra = 0;
+        if (*p < 0x80) {
+            cp = *p;
+        } else if ((*p & 0xE0) == 0xC0) {
+            cp = *p & 0x1Fu;
+            extra = 1;
+        } else if ((*p & 0xF0) == 0xE0) {
+            cp = *p & 0x0Fu;
+            extra = 2;
+        } else if ((*p & 0xF8) == 0xF0) {
+            cp = *p & 0x07u;
+            extra = 3;
+        }
+        const unsigned char *q = p + 1;
+        bool valid = true;
+        for (int i = 0; i < extra; i++) {
+            if ((*q & 0xC0) != 0x80) {
+                valid = false;
+                break;
+            }
+            cp = (cp << 6) | (*q & 0x3Fu);
+            q++;
+        }
+        if (!valid) {
+            cp = 0xFFFD;
+            q = p + 1;
+        }
+        p = q;
+        if (out + 1 >= cap)
+            break;
+        dst[out++] = static_cast<wchar_t>(cp);
+    }
+    dst[out] = L'\0';
+    return out;
+}
+
+HANDLE open_archive(const char *archive, const char *password, ShimCtx *ctx, char *error,
+                    size_t cap) {
+    RAROpenArchiveDataEx od;
+    std::memset(&od, 0, sizeof od);
+    od.ArcName = const_cast<char *>(archive);
+    od.OpenMode = RAR_OM_EXTRACT;
+    od.Callback = shim_callback;
+    od.UserData = static_cast<LPARAM>(reinterpret_cast<uintptr_t>(ctx));
+    HANDLE h = RAROpenArchiveEx(&od);
+    if (!h) {
+        map_rc(static_cast<int>(od.OpenResult), error, cap);
+        return nullptr;
+    }
+    if (password && password[0])
+        RARSetPassword(h, const_cast<char *>(password));
+    return h;
+}
+
+} // namespace
+
+extern "C" int orbit_unrar_inspect(const char *archive, const char *password, int *multi_volume,
+                                   uint64_t *unpacked_size, char *error, size_t cap) {
+    if (error && cap)
+        error[0] = '\0';
+    ShimCtx ctx = {password, nullptr, nullptr, false};
+    HANDLE h = open_archive(archive, password, &ctx, error, cap);
+    if (!h)
+        return ORBIT_UNRAR_FAILED;
+    int volume = 0;
+    uint64_t total = 0;
+    int result = ORBIT_UNRAR_OK;
+    for (;;) {
+        RARHeaderDataEx hd;
+        std::memset(&hd, 0, sizeof hd);
+        int rc = RARReadHeaderEx(h, &hd);
+        if (rc == ERAR_END_ARCHIVE)
+            break;
+        if (rc != ERAR_SUCCESS) {
+            map_rc(rc, error, cap);
+            result = ORBIT_UNRAR_FAILED;
+            break;
+        }
+        if (hd.Flags & (RHDF_SPLITAFTER | RHDF_SPLITBEFORE))
+            volume = 1;
+        if (!(hd.Flags & RHDF_DIRECTORY))
+            total += (static_cast<uint64_t>(hd.UnpSizeHigh) << 32) |
+                     static_cast<uint64_t>(hd.UnpSize);
+        rc = RARProcessFile(h, RAR_SKIP, nullptr, nullptr);
+        if (rc != ERAR_SUCCESS) {
+            map_rc(rc, error, cap);
+            result = ORBIT_UNRAR_FAILED;
+            break;
+        }
+    }
+    RARCloseArchive(h);
+    if (result == ORBIT_UNRAR_OK) {
+        if (multi_volume)
+            *multi_volume = volume;
+        if (unpacked_size)
+            *unpacked_size = total;
+    }
+    return result;
+}
+
+extern "C" int orbit_unrar_extract(const char *archive, const char *password, const char *dest,
+                                   orbit_unrar_cancel_fn cancel, void *cancel_ctx, char *error,
+                                   size_t cap) {
+    if (error && cap)
+        error[0] = '\0';
+    if (!dest || !dest[0]) {
+        set_error(error, cap, "Extraction destination is empty.");
+        return ORBIT_UNRAR_FAILED;
+    }
+    wchar_t destw[1100];
+    utf8_to_wide(dest, destw, sizeof destw / sizeof destw[0]);
+    ShimCtx ctx = {password, cancel, cancel_ctx, false};
+    HANDLE h = open_archive(archive, password, &ctx, error, cap);
+    if (!h)
+        return ORBIT_UNRAR_FAILED;
+    int result = ORBIT_UNRAR_OK;
+    for (;;) {
+        RARHeaderDataEx hd;
+        std::memset(&hd, 0, sizeof hd);
+        int rc = RARReadHeaderEx(h, &hd);
+        if (rc == ERAR_END_ARCHIVE)
+            break;
+        if (rc != ERAR_SUCCESS) {
+            map_rc(rc, error, cap);
+            result = ORBIT_UNRAR_FAILED;
+            break;
+        }
+        rc = RARProcessFileW(h, RAR_EXTRACT, destw, nullptr);
+        if (rc != ERAR_SUCCESS) {
+            if (!ctx.aborted)
+                map_rc(rc, error, cap);
+            result = ctx.aborted ? ORBIT_UNRAR_CANCELLED : ORBIT_UNRAR_FAILED;
+            break;
+        }
+    }
+    RARCloseArchive(h);
+    if (ctx.aborted)
+        result = ORBIT_UNRAR_CANCELLED;
+    return result;
+}
