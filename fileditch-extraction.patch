+++ /mnt/c/Users/KX/AppData/Local/Temp/opencode/orbit-source/orbit-store-0.7.0/backend/extract_unrar.cpp	2026-10-06 17:05:26.514818300 +0200
@@ -0,0 +1,255 @@
+#include "extract_unrar.h"
+
+#include <cstdio>
+#include <cstring>
+
+#ifndef _UNIX
+#define _UNIX /* dll.hpp's platform block; unrar's own raros.hpp provides it normally. */
+#endif
+#include "unrar/dll.hpp"
+
+/* Thin C shim over UnRAR's DLL API. Kept in C++ so dll.hpp's linkage and
+ * unrar's internals never reach the C backend. Passwords are supplied through
+ * the open-time callback because fileditch archives encrypt their headers:
+ * RARSetPassword alone is too late (the header decrypt happens during
+ * RAROpenArchiveEx). Returning -1 from UCM_PROCESSDATA raises RARX_USERBREAK,
+ * which dll.cpp catches and maps to an ERAR_* code, so cancellation never
+ * escapes this boundary as a C++ exception. */
+
+namespace {
+
+struct ShimCtx {
+    const char *password;
+    orbit_unrar_cancel_fn cancel;
+    void *cancel_ctx;
+    bool aborted;
+};
+
+void set_error(char *error, size_t cap, const char *text) {
+    if (error && cap)
+        std::snprintf(error, cap, "%s", text);
+}
+
+void map_rc(int rc, char *error, size_t cap) {
+    switch (rc) {
+        case ERAR_MISSING_PASSWORD:
+            set_error(error, cap, "The archive password could not be supplied.");
+            break;
+        case ERAR_BAD_PASSWORD:
+            set_error(error, cap, "The archive password was rejected.");
+            break;
+        case ERAR_BAD_DATA:
+            set_error(error, cap, "The archive is damaged or its password is wrong.");
+            break;
+        case ERAR_BAD_ARCHIVE:
+        case ERAR_UNKNOWN_FORMAT:
+            set_error(error, cap, "The downloaded file is not a supported RAR archive.");
+            break;
+        case ERAR_EOPEN:
+        case ERAR_EREAD:
+            set_error(error, cap, "The archive could not be read from the drive.");
+            break;
+        case ERAR_ECREATE:
+            set_error(error, cap,
+                      "A file could not be written. The drive may be full or read-only.");
+            break;
+        case ERAR_NO_MEMORY:
+        case ERAR_LARGE_DICT:
+            set_error(error, cap, "The archive needs more memory than this console has available.");
+            break;
+        default:
+            set_error(error, cap, "Archive extraction failed.");
+            break;
+    }
+}
+
+int shim_callback(UINT msg, LPARAM user_data, LPARAM p1, LPARAM p2) {
+    ShimCtx *ctx = reinterpret_cast<ShimCtx *>(static_cast<uintptr_t>(user_data));
+    switch (msg) {
+        case UCM_NEEDPASSWORD: {
+            char *buf = reinterpret_cast<char *>(p1);
+            size_t cap = static_cast<size_t>(p2);
+            if (!ctx->password || !buf || cap == 0)
+                return -1;
+            size_t n = std::strlen(ctx->password);
+            if (n + 1 > cap)
+                return -1;
+            std::memcpy(buf, ctx->password, n + 1);
+            return static_cast<int>(n);
+        }
+        case UCM_NEEDPASSWORDW: {
+            wchar_t *buf = reinterpret_cast<wchar_t *>(p1);
