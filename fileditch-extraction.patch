+        if (rc != ERAR_SUCCESS) {
+            map_rc(rc, error, cap);
+            result = ORBIT_UNRAR_FAILED;
+            break;
+        }
+    }
+    RARCloseArchive(h);
+    if (result == ORBIT_UNRAR_OK) {
+        if (multi_volume)
+            *multi_volume = volume;
+        if (unpacked_size)
+            *unpacked_size = total;
+    }
+    return result;
