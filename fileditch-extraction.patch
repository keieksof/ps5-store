+"""Append dlpsgame fileditch dumps to the embedded catalogue.
+
+Reads a discovery crawl (fd-crawl-results.json), keeps posts that declare one
+plain dump: either a single [DLPSGAME.COM]-<title ID> archive or a complete
+.partN.rar volume set (same base name, contiguous from volume 1, every member
+live), proves every kept file against the fileditch status API, fetches post
+artwork for games the catalogue does not know yet, and appends the matching
+releases plus games to catalog/releases.json and catalog/games.json. Existing
+ids are kept, so the crawl can be re-run.
+
+A post contributes at most one release. Its dump is chosen in dlpsgame's
+declared field order with one preference: a complete volume set beats a single
+file (the multi-volume mirror is the fuller dump), then first-listed wins.
+
+Run with .venv/bin/python tools/fd_catalog.py <fd-crawl-results.json> [--commit]
+The default is a dry run; --commit writes the catalogue inputs after a clean pass.
+"""
+import json
+import re
+import struct
+import sys
+import time
+import urllib.parse
+import urllib.request
+from pathlib import Path
+
+import catalog as cat
+
+DELAY = 1.2
+LIMIT_PAGE = 6_000_000
+LIMIT_IMAGE = 12_000_000
+UA = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) Orbit-Catalogue/1'}
+TITLE_IN_NAME = re.compile(r'PPSA\d+')
+VERSION_IN_NAME = re.compile(r'(\d{2}\.\d{3}\.\d{3})')
+MIRROR_PASSWORD = 'DLPSGAME.COM'
+
+
+def fetch(url, limit):
+    with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=45) as response:
+        if response.status != 200:
+            raise ValueError(f'HTTP {response.status} for {url}')
+        body = response.read(limit)
+        if len(body) >= limit:
+            raise ValueError(f'Oversized response for {url}')
+        return body
+
+
+def og_value(page, name):
+    for pattern in (rf'<meta[^>]+property=["\']{name}["\'][^>]+content=["\']([^"\']+)["\']',
+                    rf'<meta[^>]+content=["\']([^"\']+)["\'][^>]+property=["\']{name}["\']'):
+        match = re.search(pattern, page, re.I)
+        if match:
+            return urllib.parse.unquote(match.group(1)).replace('&amp;', '&')
+    return None
+
+
+def image_size(data):
+    """Pixel dimensions of the codecs the storefront serves: PNG/JPEG/GIF/WebP."""
+    if data[:8] == b'\x89PNG\r\n\x1a\n' and len(data) >= 24:
+        return struct.unpack('>II', data[16:24])
+    if data[:2] == b'\xff\xd8':
+        i = 2
+        while i + 9 < len(data):
+            if data[i] != 0xFF:
+                i += 1
+                continue
+            marker = data[i + 1]
+            if marker in (0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE,
+                          0xCF):
+                height, width = struct.unpack('>HH', data[i + 5:i + 9])
+                return width, height
+            if marker in (0xD8, 0x01) or 0xD0 <= marker <= 0xD9:
+                i += 2
+            else:
+                i += 2 + struct.unpack('>H', data[i + 2:i + 4])[0]
+        raise ValueError('JPEG without a frame header')
+    if data[:6] in (b'GIF87a', b'GIF89a'):
+        height, width = struct.unpack('<HH', data[6:8])
+        return width, height
+    if data[:4] == b'RIFF' and data[8:12] == b'WEBP':
+        if data[12:16] == b'VP8X':
+            width = 1 + int.from_bytes(data[24:27], 'little')
+            height = 1 + int.from_bytes(data[27:30], 'little')
+            return width, height
+        if data[12:16] == b'VP8 ':
+            width = struct.unpack('<H', data[26:28])[0] & 0x3FFF
+            height = struct.unpack('<H', data[28:30])[0] & 0x3FFF
+            return width, height
+        if data[12:16] == b'VP8L':
+            bits = int.from_bytes(data[21:25], 'little')
+            width = 1 + (bits & 0x3FFF)
+            height = 1 + ((bits >> 14) & 0x3FFF)
+            return width, height
+    raise ValueError('Not a supported image')
+
+
+def dump_choice(post, alive):
+    """The one dump dlpsgame declares for a post, in declared field order.
+
+    Returns [(entry, name), ...] with volume 1 first, or None. A .partN.rar set
+    wins over single files: members share one base name and digit padding, run
+    contiguously from volume 1, and every declared member must be live (a dead
+    member invalidates its whole set)."""
+    groups, singles = {}, []
+    for url in post.get('fileditch') or []:
+        name = urllib.parse.unquote(url).rsplit('/', 1)[-1]
+        match = cat.FILEDITCH_PART.fullmatch(name)
+        if match:
+            key = (match.group(1), len(match.group(2)))
+            groups.setdefault(key, []).append((alive.get(url), name, int(match.group(2))))
+        else:
+            singles.append((alive.get(url), name))
+    for members in groups.values():
+        members.sort(key=lambda item: item[2])
+        if (all(entry is not None for entry, _, _ in members)
+                and len(members) >= 2
+                and [number for _, _, number in members] == list(range(1, len(members) + 1))
+                and all(cat.FILEDITCH_NAME.fullmatch(name) for _, name, _ in members)):
+            return [(entry, name) for entry, name, _ in members]
+    for entry, name in singles:
+        if entry is not None and cat.FILEDITCH_NAME.fullmatch(name):
+            return [(entry, name)]
+    return None
+
+
+def candidates(crawl):
+    """Posts contributing one dump: a complete volume set or one plain archive."""
+    kept, skipped = [], {'no complete plain dump': 0, 'title id taken': 0}
+    seen = set()
+    for post in crawl['posts']:
+        alive = {v['url']: v for v in post.get('valid', []) if v.get('alive')}
+        volumes = dump_choice(post, alive)
+        if volumes is None:
+            skipped['no complete plain dump'] += 1
+            continue
+        name = volumes[0][1]
+        title_ids = TITLE_IN_NAME.findall(name)
+        if len(title_ids) != 1 or re.fullmatch(r'PPSA\d{5}', title_ids[0]) is None:
+            skipped['no complete plain dump'] += 1
+            continue
+        tid = title_ids[0]
+        if not all(cat.fileditch_mirror_name(vname, tid) for _, vname in volumes):
+            skipped['no complete plain dump'] += 1
+            continue
+        if post.get('titleId') and post['titleId'] != tid:
+            raise ValueError(f"{post['slug']}: post title id {post['titleId']} != file {tid}")
+        if tid in seen:
+            skipped['title id taken'] += 1
+            continue
+        seen.add(tid)
+        kept.append((post, volumes, tid, name))
+    return kept, skipped
+
+
+def main():
+    arguments = [a for a in sys.argv[1:] if a != '--commit']
+    if len(arguments) != 1:
+        raise SystemExit(__doc__)
+    commit = '--commit' in sys.argv
+    crawl = json.loads(Path(arguments[0]).read_text(encoding='utf-8'))
+    games, releases = cat.read('games.json'), cat.read('releases.json')
+    release_ids = {r['id'] for r in releases}
+    game_ids = {g['id'] for g in games}
+    by_title = {}
+    for r in releases:
+        by_title.setdefault(r['titleId'], r['gameId'])
+
+    kept, skipped = candidates(crawl)
+    new_releases, new_games, errors, listed = [], [], [], []
+    for post, volumes, tid, name in kept:
+        release_id = tid.lower() + '-folder'
+        if release_id in release_ids:
+            listed.append(f'{tid}: already listed')
+            continue
+        try:
+            sizes, pages = [], []
+            for entry, volume_name in volumes:
+                url = entry['url']
+                metadata = json.loads(fetch(cat.fileditch_status_url(url), 100_000))
+                time.sleep(DELAY)
+                if metadata.get('status') is not True or type(metadata.get('size')) is not int:
+                    raise ValueError(f'fileditch status says the file is gone: {url}')
+                if metadata['size'] != entry['size']:
+                    print(f'  {tid}: size moved {volume_name}: '
+                          f'{entry["size"]} -> {metadata["size"]}')
+                sizes.append(metadata['size'])
+                pages.append(metadata)
+            url = volumes[0][0]['url']
+            version = VERSION_IN_NAME.search(name)
+            release = {
+                'id': release_id,
+                'gameId': by_title.get(tid) or post['slug'].removesuffix('-ps5'),
+                'titleId': tid,
+                'sizeBytes': sum(sizes),
+                'provider': 'Fileditch',
+                'sourceId': 'fileditch',
+                'format': 'Folder',
+                'version': version[1] if version else None,
+                'filename': name,
+                'url': url,
+                'browserUrl': url,
+                'password': MIRROR_PASSWORD,
+                'sha256': '',
+                'importEvidence': {
+                    'sourceUrl': post['postUrl'],
+                    'sourceTitle': post['name'],
+                    'sourceTags': [tid],
+                    'sourceField': 'fileditch',
+                    'filePageUrl': url,
+                    'note': ('dlpsgame.com post mirrors the exact [DLPSGAME.COM] archive '
+                             'behind one fileditch file.' if len(volumes) == 1 else
+                             f'dlpsgame.com post mirrors the exact [DLPSGAME.COM] '
+                             f'{len(volumes)}-volume set behind separate fileditch files.'),
+                },
+            }
+            if len(volumes) > 1:
+                release['parts'] = [
+                    {'url': entry['url'], 'browserUrl': entry['url'], 'filename': volume_name,
+                     'sizeBytes': size}
+                    for (entry, volume_name), size in zip(volumes[1:], sizes[1:])
+                ]
+            release['verification'] = cat.fileditch_metadata_evidence(release, pages[0], cat.now())
+
+            if tid in by_title:
+                listed.append(f'{tid}: attach to {release["gameId"]}')
+            elif release['gameId'] in game_ids:
+                raise ValueError(f'{release["gameId"]}: game exists without this title id')
+            else:
+                page = fetch(post['postUrl'], LIMIT_PAGE).decode('utf-8', errors='replace')
+                time.sleep(DELAY)
+                cover = og_value(page, 'og:image')
+                if not cover or not cover.startswith('https://'):
+                    raise ValueError(f'{post["postUrl"]}: no HTTPS og:image artwork')
+                image = fetch(cover, LIMIT_IMAGE)
+                time.sleep(DELAY)
+                width, height = image_size(image)
+                layout = 'wide' if width >= height * 1.4 else 'ambient'
+                # dlpsgame's og:description is only "<title> PS5"; omit it like other
+                # games without a reviewed description.
+                game = {
+                    'id': release['gameId'],
+                    'title': urllib.parse.unquote(post['name']).replace('&amp;', '&'),
+                    'cover': cover,
+                    'hero': cover,
+                    'artworkLayout': layout,
+                    'addedAt': cat.now(),
+                }
+                new_games.append(game)
+                listed.append(f'{tid}: new game {game["id"]} ({width}x{height}, {layout})')
+            new_releases.append(release)
+        except Exception as exc:  # one broken post must not sink the rest silently
+            errors.append(f'{tid}: {exc}')
+
+    if errors:
+        print('Refusing to write; every kept post must verify:')
+        print('\n'.join('  ' + e for e in errors))
+        raise SystemExit(1)
+    rows = cat.compile_catalog(games + new_games, releases + new_releases)
+    print(f'Crawl kept {len(kept)} posts (skipped {skipped}); new: '
+          f'{len(new_releases)} releases, {len(new_games)} games; catalogue {len(rows)} options')
+    print('\n'.join('  ' + line for line in listed))
+    if not commit:
+        print('Dry run; pass --commit to write catalog/games.json and catalog/releases.json.')
+        return
+    if new_games:
+        cat.save('games.json', games + new_games)
+    cat.save('releases.json', releases + new_releases)
+    print('Wrote catalog/games.json and catalog/releases.json; run catalog:build next.')
+
+
+if __name__ == '__main__':
+    main()
