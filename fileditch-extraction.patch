+#define _POSIX_C_SOURCE 200809L /* O_NOFOLLOW and friends before any system header. */
+#include "extract_archive.h"
+#include <archive.h>
+#include <archive_entry.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#define ARCHIVE_PATH_MAX 2048
+
+static void fail(char *error, size_t cap, const char *prefix, const char *detail) {
+    if (error && cap)
+        snprintf(error, cap, "%s%s%s", prefix, detail ? ": " : "", detail ? detail : "");
+}
+
+/* Reject absolute paths and any ".." component so an entry can never escape. */
+static bool safe_entry(const char *name) {
+    if (!name[0] || name[0] == '/')
+        return false;
+    for (const char *p = name; *p;) {
+        const char *slash = strchr(p, '/');
+        size_t len = slash ? (size_t)(slash - p) : strlen(p);
+        if (len == 2 && p[0] == '.' && p[1] == '.')
+            return false;
+        if (!slash)
+            break;
+        p = slash + 1;
+    }
+    return true;
+}
+
+/* mkdir -p for the ancestors of `path` (the final component is the caller's). */
+static bool ensure_parents(const char *path) {
+    char copy[ARCHIVE_PATH_MAX];
+    if (snprintf(copy, sizeof copy, "%s", path) >= (int)sizeof copy)
+        return false;
+    for (char *p = copy + 1; *p; p++) {
+        if (*p != '/')
+            continue;
+        *p = 0;
+        if (mkdir(copy, 0755) && errno != EEXIST)
+            return false;
+        *p = '/';
+    }
+    return true;
+}
+
+static int open_archive(const char *path, const char *password, struct archive **out,
+                        char *error, size_t cap) {
+    struct archive *a = archive_read_new();
+    if (!a) {
+        fail(error, cap, "Could not read the archive", "out of memory");
+        return ORBIT_ARCHIVE_FAILED;
+    }
+    archive_read_support_filter_all(a);
+    archive_read_support_format_all(a);
+    if (password && password[0])
+        archive_read_add_passphrase(a, password);
+    if (archive_read_open_filename(a, path, 10240) != ARCHIVE_OK) {
+        fail(error, cap, "Could not open the archive", archive_error_string(a));
+        archive_read_free(a);
+        return ORBIT_ARCHIVE_FAILED;
+    }
+    *out = a;
+    return ORBIT_ARCHIVE_OK;
+}
+
+int orbit_archive_inspect(const char *path, const char *password, uint64_t *unpacked,
+                          char *error, size_t cap) {
+    struct archive *a;
+    if (open_archive(path, password, &a, error, cap) != ORBIT_ARCHIVE_OK)
+        return ORBIT_ARCHIVE_FAILED;
+    struct archive_entry *entry;
+    uint64_t total = 0;
+    int status;
+    while ((status = archive_read_next_header(a, &entry)) == ARCHIVE_OK) {
+        la_int64_t size = archive_entry_size(entry);
+        if (archive_entry_filetype(entry) == AE_IFREG && size > 0)
+            total += (uint64_t)size;
+    }
+    if (status != ARCHIVE_EOF) {
+        fail(error, cap, "Could not read the archive listing", archive_error_string(a));
+        archive_read_free(a);
+        return ORBIT_ARCHIVE_FAILED;
+    }
+    archive_read_free(a);
+    *unpacked = total;
+    return ORBIT_ARCHIVE_OK;
+}
+
+static int write_entry(struct archive *a, struct archive_entry *entry, const char *full,
+                       orbit_archive_cancel_fn cancel, void *ctx, char *error, size_t cap) {
+    mode_t mode = archive_entry_perm(entry) & 0777;
+    int fd = open(full, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, mode ? mode : 0644);
+    if (fd < 0) {
+        fail(error, cap, "Could not create an extracted file", strerror(errno));
+        return ORBIT_ARCHIVE_FAILED;
+    }
+    const void *block;
+    size_t block_size;
+    la_int64_t block_offset;
+    int64_t written = 0;
+    int status = ARCHIVE_OK;
+    while ((status = archive_read_data_block(a, &block, &block_size, &block_offset)) ==
+           ARCHIVE_OK) {
+        if (cancel && cancel(ctx)) {
+            close(fd);
+            return ORBIT_ARCHIVE_CANCELLED;
+        }
+        const char *cursor = block;
+        while (block_size) {
+            ssize_t n = write(fd, cursor, block_size);
+            if (n < 0 && errno == EINTR)
+                continue;
+            if (n <= 0) {
+                close(fd);
+                fail(error, cap, "Could not write an extracted file", strerror(errno));
+                return ORBIT_ARCHIVE_FAILED;
+            }
+            cursor += n;
+            block_size -= (size_t)n;
+            written += n;
+        }
+    }
+    if (close(fd)) {
+        fail(error, cap, "Could not flush an extracted file", strerror(errno));
+        return ORBIT_ARCHIVE_FAILED;
+    }
+    if (status != ARCHIVE_EOF) {
+        fail(error, cap, "Extraction failed while reading the archive",
+             archive_error_string(a));
+        return ORBIT_ARCHIVE_FAILED;
+    }
+    la_int64_t expected = archive_entry_size(entry);
+    if (expected >= 0 && written != expected) {
+        fail(error, cap, "Extraction stopped early", "an extracted file was short");
+        return ORBIT_ARCHIVE_FAILED;
+    }
+    return ORBIT_ARCHIVE_OK;
+}
+
+int orbit_archive_extract(const char *path, const char *password, const char *dest,
+                          orbit_archive_cancel_fn cancel, void *cancel_ctx, char *error,
+                          size_t cap) {
+    struct archive *a;
+    if (open_archive(path, password, &a, error, cap) != ORBIT_ARCHIVE_OK)
+        return ORBIT_ARCHIVE_FAILED;
+    struct archive_entry *entry;
+    int result = ORBIT_ARCHIVE_OK;
+    int status;
+    while ((status = archive_read_next_header(a, &entry)) == ARCHIVE_OK) {
+        if (cancel && cancel(cancel_ctx)) {
+            result = ORBIT_ARCHIVE_CANCELLED;
+            break;
+        }
+        const char *name = archive_entry_pathname(entry);
+        if (!name || !safe_entry(name)) {
+            fail(error, cap, "The archive contains an unsafe path", name ? name : "");
+            result = ORBIT_ARCHIVE_FAILED;
+            break;
+        }
+        char full[ARCHIVE_PATH_MAX];
+        if (snprintf(full, sizeof full, "%s/%s", dest, name) >= (int)sizeof full) {
+            fail(error, cap, "The archive path is too long for this drive", name);
+            result = ORBIT_ARCHIVE_FAILED;
+            break;
+        }
+        mode_t type = archive_entry_filetype(entry);
+        if (type == AE_IFDIR || (name[0] && full[strlen(full) - 1] == '/')) {
+            if (!ensure_parents(full) || (mkdir(full, 0755) && errno != EEXIST)) {
+                fail(error, cap, "Could not create an extracted folder", strerror(errno));
+                result = ORBIT_ARCHIVE_FAILED;
+                break;
+            }
+            continue;
+        }
+        if (type && type != AE_IFREG) {
+            archive_read_data_skip(a); /* Symlinks and specials never hit disk. */
+            continue;
+        }
+        if (!ensure_parents(full)) {
+            fail(error, cap, "Could not create an extracted folder", strerror(errno));
+            result = ORBIT_ARCHIVE_FAILED;
+            break;
+        }
+        result = write_entry(a, entry, full, cancel, cancel_ctx, error, cap);
+        if (result != ORBIT_ARCHIVE_OK)
+            break;
+    }
+    if (result == ORBIT_ARCHIVE_OK && status != ARCHIVE_EOF) {
+        fail(error, cap, "Extraction failed while reading the archive",
+             archive_error_string(a));
+        result = ORBIT_ARCHIVE_FAILED;
+    }
+    archive_read_free(a);
+    return result;
+}
