+#include "orbit.h"
+#include "extract_unrar.h"
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <unistd.h>
+
+/* Post-download extraction for fileditch folder dumps.
+ *
+ * fileditch mirrors dlpsgame's "plain" variants: one header+data encrypted,
+ * non-solid RAR5 archive wrapping a decrypted PS5 game folder in
+ * [DLPSGAME.COM]-<TITLE_ID>/ beside a Note.txt. The transfer worker runs:
+ * inspect (size + free space) -> extract into <root>/.orbit-staging-<job> ->
+ * locate the shallowest directory holding sce_sys/ + eboot.bin -> lift it to
+ * <root>/homebrew/<name> -> best-effort applicationDrmType=standard patch ->
+ * drop the staging tree. The caller unlinks the archive only after
+ * ORBIT_EXTRACT_OK, so a failed extraction can resume without redownloading.
+ *
+ * Console discipline (mirrors ps5upload's payload): heap buffers for anything
+ * that grows, lstat-only directory walks (never follow a symlink out), and
+ * every rename stays on one filesystem — staging shares the destination root.
+ */
+
+#define EXTRACT_PASSWORD "DLPSGAME.COM" /* Shared by every dlpsgame repack. */
+#define EXTRACT_PATH_MAX 1024
+#define EXTRACT_MAX_DEPTH 4
+#define EXTRACT_NAME_MAX 96
+#define EXTRACT_SLACK (16ULL * 1024 * 1024)
+
+static void extract_error(char *error, size_t cap, const char *text) {
+    if (error && cap)
+        copy_text(error, cap, text);
+}
+
+bool job_extracts(const Job *job) {
+    /* Phase-1 fileditch releases are single-file dlpsgame RAR5 folder dumps. */
+    return !strcmp(job->release.source, "fileditch");
+}
+
+static int extract_cancelled(void *ctx) {
+    Job *job = ctx;
+    return atomic_load(&job->cancel) || atomic_load(&orbit.stop) ? 1 : 0;
+}
+
+static int check_space(const char *root, uint64_t unpacked, char *error, size_t cap) {
+    struct statvfs v;
+    if (statvfs(root, &v))
+        return 0; /* Best effort; a full disk still surfaces as a write error. */
+    uint64_t avail = (uint64_t)v.f_bavail * (uint64_t)v.f_frsize;
+    uint64_t need = unpacked + unpacked / 64 + EXTRACT_SLACK;
+    if (avail >= need)
+        return 0;
+    if (error && cap) {
+        char wanted[40], have[40];
+        snprintf(wanted, sizeof wanted, "%.1f GB", (double)need / 1e9);
+        snprintf(have, sizeof have, "%.1f GB", (double)avail / 1e9);
+        snprintf(error, cap,
+                 "Extracting needs about %s free, but only %s is available on the drive.",
+                 wanted, have);
+    }
+    return -1;
+}
+
+static int has_game_layout(const char *path) {
+    struct stat st;
+    char sub[EXTRACT_PATH_MAX];
+    if (snprintf(sub, sizeof sub, "%s/sce_sys", path) >= (int)sizeof sub)
+        return 0;
+    if (lstat(sub, &st) || !S_ISDIR(st.st_mode))
+        return 0;
+    if (snprintf(sub, sizeof sub, "%s/eboot.bin", path) >= (int)sizeof sub)
+        return 0;
+    if (lstat(sub, &st) || !S_ISREG(st.st_mode))
+        return 0;
+    return 1;
+}
+
+typedef struct {
+    char *path;
+    unsigned depth;
+} WalkEntry;
+
+static int walk_push(WalkEntry **items, size_t *count, size_t *capacity, const char *path,
+                     unsigned depth) {
+    if (*count == *capacity) {
+        size_t next = *capacity ? *capacity * 2 : 16;
+        WalkEntry *grown = realloc(*items, next * sizeof *grown);
+        if (!grown)
+            return -1;
+        *items = grown;
+        *capacity = next;
+    }
+    size_t length = strlen(path) + 1;
+    char *copy = malloc(length);
+    if (!copy)
+        return -1;
+    memcpy(copy, path, length);
+    (*items)[*count].path = copy;
+    (*items)[*count].depth = depth;
+    (*count)++;
+    return 0;
+}
+
+/* Breadth-first so the shallowest match wins: wrappers nest the game below
+ * [DLPSGAME.COM]-<id>/, and some dumps carry a decrypted/ copy of eboot.bin
+ * deeper down that must not be mistaken for the install root. Returns 1 when
+ * found, 0 when absent, -1 on allocation failure. */
+static int find_game_dir(const char *staging, char *out, size_t cap) {
+    WalkEntry *items = NULL;
+    size_t count = 0, capacity = 0;
+    if (walk_push(&items, &count, &capacity, staging, 0))
+        return -1;
+    int result = 0;
+    for (size_t i = 0; i < count && result == 0; i++) {
+        if (has_game_layout(items[i].path)) {
+            if (strlen(items[i].path) >= cap)
+                result = -1;
+            else {
+                strcpy(out, items[i].path);
+                result = 1;
+            }
+            break;
+        }
+        if (items[i].depth >= EXTRACT_MAX_DEPTH)
+            continue;
+        DIR *dir = opendir(items[i].path);
+        if (!dir)
+            continue;
+        struct dirent *entry;
+        while (result == 0 && (entry = readdir(dir))) {
+            if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, ".."))
+                continue;
+            size_t base = strlen(items[i].path), name = strlen(entry->d_name);
+            if (base + 1 + name + 1 > EXTRACT_PATH_MAX)
+                continue;
+            char *child = malloc(base + 1 + name + 1);
+            if (!child) {
+                result = -1;
+                break;
+            }
+            memcpy(child, items[i].path, base);
+            child[base] = '/';
+            memcpy(child + base + 1, entry->d_name, name + 1);
+            struct stat st;
+            if (!lstat(child, &st) && S_ISDIR(st.st_mode) &&
+                walk_push(&items, &count, &capacity, child, items[i].depth + 1)) {
+                free(child);
+                result = -1;
+                break;
+            }
+            free(child);
+        }
+        closedir(dir);
+    }
+    for (size_t i = 0; i < count; i++)
+        free(items[i].path);
+    free(items);
+    return result;
+}
+
+static void rm_tree(const char *path) {
+    struct stat st;
+    if (lstat(path, &st))
+        return;
+    if (!S_ISDIR(st.st_mode)) {
+        unlink(path); /* Files, symlinks, and leftovers of any other type. */
+        return;
+    }
+    DIR *dir = opendir(path);
+    if (dir) {
+        struct dirent *entry;
+        while ((entry = readdir(dir))) {
+            if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, ".."))
+                continue;
+            size_t base = strlen(path), name = strlen(entry->d_name);
+            if (base + 1 + name + 1 > EXTRACT_PATH_MAX)
+                continue;
+            char *child = malloc(base + 1 + name + 1);
+            if (!child)
+                break;
+            memcpy(child, path, base);
+            child[base] = '/';
+            memcpy(child + base + 1, entry->d_name, name + 1);
+            rm_tree(child); /* Recurses into directories, unlinks the rest. */
+            free(child);
+        }
+        closedir(dir);
+    }
+    rmdir(path);
+}
+
+/* Archive basename minus the extension, sanitized for exFAT/NTFS names. */
+static void final_folder_name(const char *filename, char *out, size_t cap) {
+    const char *dot = strrchr(filename, '.');
+    size_t length = dot && dot != filename ? (size_t)(dot - filename) : strlen(filename);
+    if (length >= cap)
+        length = cap - 1;
+    for (size_t i = 0; i < length; i++) {
+        unsigned char c = (unsigned char)filename[i];
+        if (c < 0x20 || c == 0x7f || strchr("<>:\"/\\|?*", (char)c))
+            out[i] = '_';
+        else
+            out[i] = (char)c;
+    }
+    out[length] = '\0';
+    while (length > 0 && (out[length - 1] == '.' || out[length - 1] == ' '))
+        out[--length] = '\0';
+    if (!length)
+        copy_text(out, cap, "game");
+}
+
+/* ps5upload patches the same field before registering a dump: decrypted
+ * folders keep a disc/PSN drm type that makes the launcher refuse to boot.
+ * Best effort — a dump whose param.json is already standard stays untouched. */
+static void patch_drm_type(const char *game_dir) {
+    char path[EXTRACT_PATH_MAX];
+    if (snprintf(path, sizeof path, "%s/sce_sys/param.json", game_dir) >= (int)sizeof path)
+        return;
+    unsigned char *data = NULL;
+    size_t length = 0;
+    if (read_regular_file(path, 1024 * 1024, &data, &length))
+        return;
+    cJSON *root = cJSON_ParseWithLength((const char *)data, length);
+    free(data);
+    if (!root)
+        return;
+    char *out = NULL;
+    cJSON *drm = cJSON_GetObjectItemCaseSensitive(root, "applicationDrmType");
+    if (!cJSON_IsString(drm) || !drm->valuestring || strcmp(drm->valuestring, "standard")) {
+        cJSON *replacement = cJSON_CreateString("standard");
+        if (replacement) {
+            if (drm)
+                cJSON_ReplaceItemInObject(root, drm->string, replacement);
+            else
+                cJSON_AddItemToObject(root, "applicationDrmType", replacement);
+            out = cJSON_PrintUnformatted(root);
+        }
+    }
+    cJSON_Delete(root);
+    if (!out)
+        return;
+    char tmp[EXTRACT_PATH_MAX];
+    if (snprintf(tmp, sizeof tmp, "%s.orbit", path) < (int)sizeof tmp) {
+        FILE *file = fopen(tmp, "wb");
+        if (file) {
+            size_t written = strlen(out);
+            bool ok = fwrite(out, 1, written, file) == written;
+            if (fflush(file) || fsync(fileno(file)))
+                ok = false;
+            if (fclose(file))
+                ok = false;
+            if (!ok)
+                unlink(tmp);
+            else if (rename(tmp, path))
+                unlink(tmp);
+        }
+    }
+    free(out);
