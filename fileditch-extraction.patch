+#define ORBIT_ARCHIVE_FAILED 1
+#define ORBIT_ARCHIVE_CANCELLED 2
+/* Return non-zero to abort, like orbit_unrar_cancel_fn. */
+typedef int (*orbit_archive_cancel_fn)(void *ctx);
+/* Read headers only: total unpacked size of every regular member. */
+int orbit_archive_inspect(const char *path, const char *password, uint64_t *unpacked,
+                          char *error, size_t cap);
+/* Extract every member under dest (created by the caller). Symlinks and
+ * special files are skipped; entries that would escape dest are rejected. */
+int orbit_archive_extract(const char *path, const char *password, const char *dest,
+                          orbit_archive_cancel_fn cancel, void *cancel_ctx, char *error,
+                          size_t cap);
+#ifdef __cplusplus
+}
+#endif
+#endif
