+extern "C" int orbit_unrar_extract(const char *archive, const char *password, const char *dest,
+                                   orbit_unrar_cancel_fn cancel, void *cancel_ctx, char *error,
+                                   size_t cap) {
+    if (error && cap)
+        error[0] = '\0';
+    if (!dest || !dest[0]) {
+        set_error(error, cap, "Extraction destination is empty.");
+        return ORBIT_UNRAR_FAILED;
+    }
+    wchar_t destw[1100];
+    utf8_to_wide(dest, destw, sizeof destw / sizeof destw[0]);
+    ShimCtx ctx = {password, cancel, cancel_ctx, false};
+    HANDLE h = open_archive(archive, password, &ctx, error, cap);
+    if (!h)
+        return ORBIT_UNRAR_FAILED;
+    int result = ORBIT_UNRAR_OK;
+    for (;;) {
+        RARHeaderDataEx hd;
+        std::memset(&hd, 0, sizeof hd);
+        int rc = RARReadHeaderEx(h, &hd);
+        if (rc == ERAR_END_ARCHIVE)
+            break;
+        if (rc != ERAR_SUCCESS) {
+            map_rc(rc, error, cap);
+            result = ORBIT_UNRAR_FAILED;
+            break;
+        }
+        rc = RARProcessFileW(h, RAR_EXTRACT, destw, nullptr);
+        if (rc != ERAR_SUCCESS) {
+            if (!ctx.aborted)
+                map_rc(rc, error, cap);
+            result = ctx.aborted ? ORBIT_UNRAR_CANCELLED : ORBIT_UNRAR_FAILED;
+            break;
+        }
+    }
+    RARCloseArchive(h);
+    if (ctx.aborted)
+        result = ORBIT_UNRAR_CANCELLED;
+    return result;
+}
