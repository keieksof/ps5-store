+static bool signed_link(const char *query) {
+    bool md5 = false, expires = false, exp = false, sig = false;
+    while (*query) {
+        const char *end = strchr(query, '&');
+        if (!end) end = query + strlen(query);
+        const char *eq = (const char *)memchr(query, '=', (size_t)(end - query));
+        if (eq) {
+            size_t key = (size_t)(eq - query), value = (size_t)(end - eq - 1);
+            if (value) {
+                if (key == 3 && !memcmp(query, "md5", 3)) md5 = true;
+                else if (key == 7 && !memcmp(query, "expires", 7)) expires = true;
+                else if (key == 3 && !memcmp(query, "exp", 3)) exp = true;
+                else if (key == 3 && !memcmp(query, "sig", 3)) sig = true;
+            }
+        }
+        if (!*end) break;
+        query = end + 1;
+    }
+    return (md5 && expires) || (exp && sig);
+}
