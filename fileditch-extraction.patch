+static void rm_tree(const char *path) {
+    struct stat st;
+    if (lstat(path, &st))
+        return;
+    if (!S_ISDIR(st.st_mode)) {
+        unlink(path); /* Files, symlinks, and leftovers of any other type. */
+        return;
+    }
+    DIR *dir = opendir(path);
+    if (dir) {
+        struct dirent *entry;
+        while ((entry = readdir(dir))) {
+            if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, ".."))
+                continue;
+            size_t base = strlen(path), name = strlen(entry->d_name);
+            if (base + 1 + name + 1 > EXTRACT_PATH_MAX)
+                continue;
+            char *child = malloc(base + 1 + name + 1);
+            if (!child)
+                break;
+            memcpy(child, path, base);
+            child[base] = '/';
+            memcpy(child + base + 1, entry->d_name, name + 1);
+            rm_tree(child); /* Recurses into directories, unlinks the rest. */
+            free(child);
+        }
+        closedir(dir);
+    }
+    rmdir(path);
+}
+
+/* Archive basename minus the extension, sanitized for exFAT/NTFS names. */
+static void final_folder_name(const char *filename, char *out, size_t cap) {
+    const char *dot = strrchr(filename, '.');
+    size_t length = dot && dot != filename ? (size_t)(dot - filename) : strlen(filename);
+    if (length >= cap)
+        length = cap - 1;
+    for (size_t i = 0; i < length; i++) {
+        unsigned char c = (unsigned char)filename[i];
+        if (c < 0x20 || c == 0x7f || strchr("<>:\"/\\|?*", (char)c))
+            out[i] = '_';
+        else
+            out[i] = (char)c;
+    }
+    out[length] = '\0';
+    while (length > 0 && (out[length - 1] == '.' || out[length - 1] == ' '))
+        out[--length] = '\0';
+    if (!length)
+        copy_text(out, cap, "game");
+}
+
+/* ps5upload patches the same field before registering a dump: decrypted
+ * folders keep a disc/PSN drm type that makes the launcher refuse to boot.
+ * Best effort — a dump whose param.json is already standard stays untouched. */
+static void patch_drm_type(const char *game_dir) {
+    char path[EXTRACT_PATH_MAX];
+    if (snprintf(path, sizeof path, "%s/sce_sys/param.json", game_dir) >= (int)sizeof path)
+        return;
+    unsigned char *data = NULL;
+    size_t length = 0;
+    if (read_regular_file(path, 1024 * 1024, &data, &length))
+        return;
+    cJSON *root = cJSON_ParseWithLength((const char *)data, length);
+    free(data);
+    if (!root)
+        return;
+    char *out = NULL;
+    cJSON *drm = cJSON_GetObjectItemCaseSensitive(root, "applicationDrmType");
+    if (!cJSON_IsString(drm) || !drm->valuestring || strcmp(drm->valuestring, "standard")) {
+        cJSON *replacement = cJSON_CreateString("standard");
+        if (replacement) {
+            if (drm)
+                cJSON_ReplaceItemInObject(root, drm->string, replacement);
+            else
+                cJSON_AddItemToObject(root, "applicationDrmType", replacement);
+            out = cJSON_PrintUnformatted(root);
+        }
+    }
+    cJSON_Delete(root);
+    if (!out)
+        return;
+    char tmp[EXTRACT_PATH_MAX];
+    if (snprintf(tmp, sizeof tmp, "%s.orbit", path) < (int)sizeof tmp) {
+        FILE *file = fopen(tmp, "wb");
+        if (file) {
+            size_t written = strlen(out);
+            bool ok = fwrite(out, 1, written, file) == written;
+            if (fflush(file) || fsync(fileno(file)))
+                ok = false;
+            if (fclose(file))
+                ok = false;
+            if (!ok)
+                unlink(tmp);
+            else if (rename(tmp, path))
+                unlink(tmp);
+        }
+    }
+    free(out);
+}
+
+int job_extract(Job *job, int dir, const char *partial, char *error, size_t cap) {
+    if (error && cap)
+        error[0] = '\0';
+    /* storage_open() resolves the job directory as <root>/homebrew; unrar needs
+     * the real path because it opens the archive itself. */
+    char archive[EXTRACT_PATH_MAX];
+    if (snprintf(archive, sizeof archive, "%s/homebrew/%s", job->root, partial) >=
+        (int)sizeof archive) {
+        extract_error(error, cap, "The archive path is too long for this drive.");
+        return ORBIT_EXTRACT_FAILED;
+    }
+    const char *password = job->release.password[0] ? job->release.password : EXTRACT_PASSWORD;
+    unsigned volumes = release_volumes(&job->release);
+    /* .rar goes to the vendored UnRAR (native multi-volume support); every
+     * other container the catalogue admits (.7z/.zip/.tar…) goes to libarchive. */
+    bool rar = has_suffix(partial, ".rar");
+    int volume = 0;
+    uint64_t unpacked = 0;
+    if (rar) {
+        /* UnRAR resolves sibling volumes itself; verify they are all present
+         * and intact first so a missing part fails before staging. */
+        for (unsigned k = 1; k < volumes; k++) {
+            char part[EXTRACT_PATH_MAX];
+            struct stat st;
+            if (snprintf(part, sizeof part, "%s/homebrew/%s", job->root,
+                         job->release.parts[k - 1].filename) >= (int)sizeof part ||
+                stat(part, &st) || !S_ISREG(st.st_mode) ||
+                st.st_size != job->release.parts[k - 1].size) {
+                if (error && cap)
+                    snprintf(error, cap, "Part %u of %u is missing or incomplete on the drive.",
+                             k + 1, volumes);
+                return ORBIT_EXTRACT_FAILED;
+            }
+        }
+        if (orbit_unrar_inspect(archive, password, &volume, &unpacked, error, cap) !=
+            ORBIT_UNRAR_OK)
+            return ORBIT_EXTRACT_FAILED;
+        if (volume && volumes == 1) {
+            extract_error(error, cap,
+                          "The archive spans multiple volumes; only single-file downloads are "
+                          "supported.");
+            return ORBIT_EXTRACT_FAILED;
+        }
+    } else if (volumes > 1) {
+        extract_error(error, cap, "Only RAR archives may be split across parts.");
+        return ORBIT_EXTRACT_FAILED;
+    } else if (orbit_archive_inspect(archive, password, &unpacked, error, cap) !=
+               ORBIT_ARCHIVE_OK)
+        return ORBIT_EXTRACT_FAILED;
+    if (check_space(job->root, unpacked, error, cap))
+        return ORBIT_EXTRACT_FAILED;
+
+    char staging[EXTRACT_PATH_MAX];
+    if (snprintf(staging, sizeof staging, "%s/.orbit-staging-%s", job->root, job->id) >=
+        (int)sizeof staging) {
+        extract_error(error, cap, "The staging path is too long for this drive.");
+        return ORBIT_EXTRACT_FAILED;
+    }
+    rm_tree(staging); /* Leftover from an interrupted run of the same job. */
+    if (mkdir(staging, 0755) && errno != EEXIST) {
+        extract_error(error, cap, "Could not create a staging folder on the destination drive.");
+        return ORBIT_EXTRACT_FAILED;
+    }
+    int outcome = rar ? orbit_unrar_extract(archive, password, staging, extract_cancelled, job,
+                                            error, cap)
+                      : orbit_archive_extract(archive, password, staging, extract_cancelled, job,
+                                              error, cap);
+    if (outcome != ORBIT_UNRAR_OK) {
+        rm_tree(staging);
+        return outcome == ORBIT_UNRAR_CANCELLED ? ORBIT_EXTRACT_CANCELLED : ORBIT_EXTRACT_FAILED;
+    }
+
+    char game[EXTRACT_PATH_MAX];
+    int found = find_game_dir(staging, game, sizeof game);
+    if (found <= 0) {
+        rm_tree(staging);
+        extract_error(error, cap,
+                      found == 0 ? "The archive does not contain a PS5 game folder "
+                                   "(sce_sys and eboot.bin)."
+                                 : "Not enough memory to map the extracted folders.");
+        return ORBIT_EXTRACT_FAILED;
+    }
+    char name[EXTRACT_NAME_MAX];
+    final_folder_name(job->filename, name, sizeof name);
+    struct stat existing;
+    if (!fstatat(dir, name, &existing, AT_SYMLINK_NOFOLLOW)) {
+        rm_tree(staging);
+        if (error && cap)
+            snprintf(error, cap,
+                     "A folder named \"%s\" already exists on the destination drive.", name);
+        return ORBIT_EXTRACT_FAILED;
+    }
+    char final_path[EXTRACT_PATH_MAX];
+    if (snprintf(final_path, sizeof final_path, "%s/homebrew/%s", job->root, name) >=
+        (int)sizeof final_path) {
+        rm_tree(staging);
+        extract_error(error, cap, "The install path is too long for this drive.");
+        return ORBIT_EXTRACT_FAILED;
+    }
+    if (rename(game, final_path)) {
+        if (error && cap)
+            snprintf(error, cap, "Could not move the extracted game into place: %s.",
+                     strerror(errno));
+        rm_tree(staging);
+        return ORBIT_EXTRACT_FAILED;
+    }
+    if (strcmp(game, staging))
+        rm_tree(staging); /* Wrapper and Note.txt remain behind. */
+    fsync(dir);
+    int root_dir = open(job->root, O_RDONLY | O_DIRECTORY);
+    if (root_dir >= 0) {
+        fsync(root_dir);
+        close(root_dir);
+    }
+    patch_drm_type(final_path);
+    return ORBIT_EXTRACT_OK;
+}
